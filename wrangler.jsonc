{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mocui-inventory-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE"
    }
  ],
  "vars": {
    "APP_RELEASE": "1.0.0",
    "APP_MODE": "self-use",
    "INITIAL_SETUP_CODE": "nRshQCgM9NwvxrCP2H4KfGBo"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
